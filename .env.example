# Copy this file to .env and fill in whichever backend you want to use.
# Leave everything unset to run the whole pipeline in MOCK_MODE, free of charge.

# Which backend to use: vertex | gemini | anthropic | auto
# (default: auto, tries them in that order)
LLM_PROVIDER=

# --- Gemini API (easiest: free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=

# --- Vertex AI (Gemini on Google Cloud) ---
# Auth uses application default credentials, so there is no key to paste:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- LangSmith tracing (optional; free account at https://smith.langchain.com) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=adloop
