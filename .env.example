# Copy this file to .env and fill in whichever backend you want to use.
# Leave everything unset to run the whole pipeline in MOCK_MODE, free of charge.

# Which backend to use: vertex | anthropic | auto (default: auto, prefers vertex)
LLM_PROVIDER=

# --- Vertex AI (Gemini) ---
# Auth uses application default credentials, so there is no key to paste:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
